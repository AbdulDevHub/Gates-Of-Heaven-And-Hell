{
  "manifest_version": 3,
  "name": "Gates Of Heaven & Hell",
  "version": "2.1.0",
  "description": "A no-bypass website blocker: Hell gates for blocked sites, Pause & Think gates for habits, schedules, lockable rules and streaks.",
  "homepage_url": "https://github.com/AbdulDevHub/Gates-Of-Heaven-And-Hell",
  "incognito": "split",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Gates Of Heaven & Hell",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "192": "icons/icon192.png",
      "512": "icons/icon512.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "192": "icons/icon192.png",
    "512": "icons/icon512.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["scripts/rules-engine.js", "scripts/content-youtube.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pages/blocked.html",
        "pages/pause.html",
        "styles/blocked.css",
        "styles/pause.css",
        "styles/heaven.css",
        "scripts/blocked.js",
        "scripts/sfx.js",
        "scripts/pause.js",
        "scripts/heaven.js",
        "scripts/reminders.js",
        "scripts/shared.js",
        "scripts/rules-engine.js",
        "icons/icon32.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
