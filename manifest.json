{
  "manifest_version": 3,
  "name": "Gates Of Heaven & Hell",
  "version": "1.0.0",
  "description": "A rule-based site blocker with no bypass, delayed & reflection-gated rule removal, and lockable rules.",
  "incognito": "split",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Gates Of Heaven & Hell — Open Rule Book",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "192": "icons/icon192.png",
      "512": "icons/icon512.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "192": "icons/icon192.png",
    "512": "icons/icon512.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["scripts/rules-engine.js", "scripts/content-youtube.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pages/blocked.html",
        "styles/blocked.css",
        "scripts/blocked.js",
        "scripts/rules-engine.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
